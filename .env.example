# Copy to .env. Replace database/JWT placeholders; replace Gemini key only if using that provider.
APP_NAME=permission-aware-rag
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
POSTGRES_DB=permission_aware_rag
POSTGRES_USER=rag_app
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_ONLY_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://rag_app:REPLACE_WITH_LOCAL_ONLY_DATABASE_PASSWORD@localhost:5432/permission_aware_rag
COMPOSE_DATABASE_URL=postgresql+psycopg://rag_app:REPLACE_WITH_LOCAL_ONLY_DATABASE_PASSWORD@postgres:5432/permission_aware_rag
POSTGRES_PORT=5432
QDRANT_PORT=6333
APP_PORT=8000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
QDRANT_URL=http://localhost:6333
COMPOSE_QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Safe default: deterministic local client, no external LLM call.
LLM_PROVIDER=mock
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=REPLACE_WITH_GEMINI_API_KEY
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=60
